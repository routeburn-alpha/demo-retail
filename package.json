{
  "name": "demo-retail",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.framework.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "precommit": "npm run check && npm run build && npm test",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:standards": "tsx scripts/seed-standards.ts",
    "db:seed:facets": "tsx scripts/seed-facets.ts",
    "db:seed:lowstock": "tsx scripts/demo-lowstock.ts",
    "demo:reset": "bash scripts/demo-reset.sh",
    "demo:reset:studio": "tsx scripts/demo-reset-studio.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^5.5.0",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@vercel/config": "^0.5.1",
    "@vitest/browser": "^2.1.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "playwright": "1.56.1",
    "postcss": "^8.4.47",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.4",
    "vitest-browser-svelte": "^1.0.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  }
}
